# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# O projeto usa o formato NOVO de chave (sb_publishable_ / sb_secret_), não o
# JWT legado. Ambas saem de Project Settings -> API keys.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
# Usada para montar links absolutos (o link de pagamento no e-mail, o
# success_url da Stripe). Sem barra no fim.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
# Developers -> API keys, com o Test mode LIGADO durante o desenvolvimento.
# Em produção use uma chave RESTRITA (rk_live_), não a secreta completa.
#
# SEM STRIPE_SECRET_KEY nada quebra: a tela de pagamento detecta a ausência e
# mostra só o caminho offline (Venmo, dinheiro, cheque), em vez de oferecer um
# botão que levaria a erro. É o estado de produção enquanto o clube não entrega
# as chaves live.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# Impresso pelo `stripe listen` na primeira linha, durante o desenvolvimento.
# Em produção, criado junto com o endpoint de webhook no painel da Stripe.
#
#   stripe listen --events checkout.session.completed,checkout.session.async_payment_succeeded,\
#     checkout.session.async_payment_failed,payment_intent.succeeded,payment_intent.processing,\
#     payment_intent.payment_failed,charge.refunded,charge.dispute.created \
#     --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---------------------------------------------------------------------------
# E-mail transacional (Resend)
# ---------------------------------------------------------------------------
# ENQUANTO ESTAS DUAS NÃO EXISTIREM, nada quebra: as notificações ficam na
# caixa de saída com status `pending` e o painel de pagamentos mostra quantas
# estão esperando. No dia em que a conta for criada, basta preencher aqui e
# fazer o deploy — não há mudança de código.
#
# O remetente precisa ser de um domínio verificado na Resend. Enviar de um
# domínio não verificado cai em spam ou é recusado.
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Cron
# ---------------------------------------------------------------------------
# Protege /api/cron/notifications. Sem este valor a rota responde 503 e fica
# fechada, em vez de ficar aberta para qualquer um drenar a fila de e-mails.
# Gere algo longo e aleatório.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Opcionais
# ---------------------------------------------------------------------------
# MFA obrigatória para admin. Fora de 'true', o 2FA é opcional.
REQUIRE_ADMIN_MFA=false
